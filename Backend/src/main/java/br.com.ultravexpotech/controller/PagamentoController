package br.com.ultravexpotech.controller;

import br.com.ultravexpotech.service.PagamentoService;
import com.mercadopago.MercadoPagoConfig;
import com.mercadopago.client.preference.PreferenceBackUrlsRequest;
import com.mercadopago.client.preference.PreferenceClient;
import com.mercadopago.client.preference.PreferenceItemRequest;
import com.mercadopago.client.preference.PreferenceRequest;
import com.mercadopago.resources.preference.Preference;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.math.BigDecimal;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;

@RestController
@RequestMapping("/pagamento")
@CrossOrigin(origins = "*")
public class PagamentoController {

    @Autowired
    //metodo do folgado
    private PagamentoService pagamentoService;

    @GetMapping("/verificar-cartao/{nomeUsuario}")
    public ResponseEntity<Boolean> verificar(@PathVariable String nomeUsuario) {
        boolean temCartao = pagamentoService.usuarioTemCartaoValido(nomeUsuario);
        return ResponseEntity.ok(temCartao);
    }

    // Integração com Mercado Pago: cria a preferência de pagamento
    // Token de teste — substitua por uma variável de ambiente em produção
    @PostMapping("/criar-preferencia")
    public Map<String, String> criarPreferencia(@RequestBody List<Map<String, Object>> itens) throws Exception {
        MercadoPagoConfig.setAccessToken("TEST-6908087959013640-052704-f964a601b9a6d181eadbf837d9efaf12-46550772");

        List<PreferenceItemRequest> itemRequests = new ArrayList<>();
        for (Map<String, Object> item : itens) {
            itemRequests.add(PreferenceItemRequest.builder()
                    .title((String) item.get("nome"))
                    .quantity((Integer) item.get("quantidade"))
                    .unitPrice(new BigDecimal(item.get("preco").toString()))
                    .build());
        }

        PreferenceRequest request = PreferenceRequest.builder()
                .items(itemRequests)
                .backUrls(PreferenceBackUrlsRequest.builder()
                        .success("http://localhost:3000/carrinho")
                        .failure("http://localhost:3000/carrinho")
                        .pending("http://localhost:3000/carrinho")
                        .build())
                .build();

        Preference preference = new PreferenceClient().create(request);
        return Map.of("url", preference.getInitPoint());
    }
}
